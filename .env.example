# Kopyala: cp .env.example .env  ve değerleri doldur.
# Bu dosyayı asla GitHub'a veya Discord'a atma.

# Sunucu portu
PORT=3000

# Sitenin tam adresi. Geliştirmede localhost, yayında https://bio.yours gibi.
# OAuth redirect URI'leri bu adrese göre oluşur.
BASE_URL=http://localhost:3000

# Oturum imzalama anahtarı. Uzun ve rastgele olmalı.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# JSONBin. MASTER key sadece sunucuda kalır, tarayıcıya asla gitmez.
# Bin ID boş bırakılırsa ilk açılışta otomatik oluşturulur ve konsola yazılır.
JSONBIN_MASTER_KEY=
JSONBIN_BIN_ID=

# Google Cloud OAuth2
# Yetkili yönlendirme URI: BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth2
# Yönlendirme URI: BASE_URL/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# İlk Owner hesapları, virgülle ayır.
# Format: google:<sub> veya discord:<kullanıcı_id>
# Bu hesaplar giriş yapınca otomatik Owner olur.
OWNER_IDS=
